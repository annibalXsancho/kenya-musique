[Unit]
Description=Outil (PocketBase + front)
After=network.target

[Service]
User=outil
Group=outil
WorkingDirectory=/opt/outil
# Écoute en local uniquement : l'accès passe par Tailscale (tailscale serve), jamais directement depuis internet.
ExecStart=/opt/outil/pocketbase serve --http=127.0.0.1:8090 --dir=/opt/outil/pb_data --publicDir=/opt/outil/pb_public --migrationsDir=/opt/outil/pb_migrations
Restart=always
RestartSec=3
LimitNOFILE=4096
NoNewPrivileges=true
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
